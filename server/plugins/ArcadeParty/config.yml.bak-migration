# ============================================================
# 街机派对（ArcadeParty）配置文件
# 修改后在非对局状态执行 /arcade reload，或重启服务器
# 也可以管理员用 /arcade menu 打开菜单，在游戏里直接调
# 注意：YAML 的冒号后面必须有空格，缩进必须用空格（不能用 Tab）
# ============================================================

# ---------- 人数 ----------
# 最少开局人数（至少 2）
min-players: 2
# 每局派对最多多少名玩家（超出部分不能加入派对）
max-players: 16

# ---------- 派对流程 ----------
# 每局派对串烧几个小游戏（最多不超过启用的小游戏数量）
games-per-party: 4
# 两个小游戏之间的准备阶段（秒）
transition-seconds: 3
# 单个小游戏最长等多久（秒）：超时按“无人得分”进入下一局，防止卡死
round-timeout-seconds: 600

# ---------- 星星 ----------
stars:
  first: 3
  second: 2
  third: 1
  # 因为人数超过小游戏上限而当轮旁观的人，补偿多少颗星
  spectator-bonus: 1

# ---------- 场地 ----------
# 派对的等待区（聚会开始前后都在这里集合）
lobby: world_mini_game,-262.50,51.00,594.68,-90.1,-10.1
# 颁奖台区域：观众站位 + 第 1/2/3 名的站位
podium:
  audience: ''
  first: world_mini_game,-249.68,57.00,594.48,90.1,6.3
  second: world_mini_game,-249.80,55.00,599.40,91.1,2.9
  third: world_mini_game,-249.58,53.00,589.38,89.7,3.0
  end-delay-seconds: 10

# ---------- 颁奖烟花 ----------
fireworks:
  enabled: true
  # 每次放几颗
  count: 3
  # 每颗之间隔多少 tick
  interval-ticks: 10
  # 升空多少 tick 后爆炸（20 tick = 1 秒）
  flight-ticks: 30
  # 烟花类型（BALL / BALL_LARGE / STAR / CREEPER / BURST）
  types:
  - BALL
  - BALL_LARGE
  - STAR
  - CREEPER
  - BURST
  spots:
  - world_mini_game,-258.50,51.00,585.50,0.0,0.0
