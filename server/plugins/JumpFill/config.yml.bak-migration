# 等待人数
min-players: 2
# 最多 16 人（插件只有 16 种染色玻璃颜色）
max-players: 16
# 落水/跳偏后传回高台的延迟（tick）
respawn-delay-ticks: 8
# 结束结算后停留多久再送回主城（tick）
end-delay-ticks: 60

# 场地（OP 用 /jump setwater 1|2、/jump addstart、/jump setlobby 设置，再 /jump save）
arena:
  world: world_mini_game
  # 水域两个对角（只支持一格高，两角的 Y 必须相同）
  water-pos1: world_mini_game,18.00,0.00,18.00,0.00,0.00
  water-pos2: world_mini_game,26.00,0.00,26.00,0.00,0.00
  # 等待点（不设则使用第一个出发点）
  lobby: world_mini_game,22.44,43.00,22.02,0.75,-3.90
  # 高台出发点列表，每个玩家按加入顺序分配
  start-points:
  - world_mini_game,22.50,29.00,16.50,0.75,-0.15
  - world_mini_game,28.50,29.00,22.50,90.30,0.15
  - world_mini_game,22.50,29.00,28.50,-179.25,0.00
  - world_mini_game,16.50,29.00,22.50,-89.40,0.15
countdown:
  enabled: true
  seconds: 3
  freeze: true
  title: '&e游戏即将开始：{time}'
  subtitle: '&7准备好'

