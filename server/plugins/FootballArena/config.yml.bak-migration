# ===== 绿茵足球配置 =====
# 注意：线上真实生效的一份在 server/plugins/FootballArena/config.yml，
# 这里只是新服首次启动用的模板（关服时会由 saveAll 回写）。

# 人数（min 同时是等待倒计时的启动门槛；max 满 3 秒自动开局）
min-players: 2
max-players: 10

# 胜负：先进 goals-to-win 球获胜；或 match-seconds 秒到点时进球多者胜。
# 时间到平局 -> 金球加时 golden-goal-seconds 秒（先进球者胜），仍平 -> 平局。
goals-to-win: 3
match-seconds: 300
golden-goal-seconds: 120

# 道具（右键）：冲刺 = 速度效果 sprint-seconds 秒，冷却 sprint-cooldown 秒；
#              高跳 = 立即向上弹起，冷却 jump-cooldown 秒。
sprint-seconds: 5
sprint-cooldown: 5
jump-cooldown: 5

# 球（自定义物理：重力/阻力/反弹/滚动摩擦，撞墙按法线反射）
ball:
  material: BLACK_CONCRETE # 球的方块材质（BlockDisplay 整块渲染，必须是方块类，非方块回退白色混凝土）
  scale: 0.7 # 球的视觉大小（= 方块边长，方块居中在球心；碰撞半径恒等于 scale/2）
  gravity: 0.08 # 每 tick 下落加速度
  drag: 0.985 # 空中水平阻力（每 tick 衰减系数）
  ground-friction: 0.86 # 落地反弹后的水平衰减（滚动摩擦）
  bounce: 0.6 # 撞墙/落地反弹系数
  push-speed: 0.32 # 球员身体带球时给球的水平速度（撞人挡球也靠它）
  rest-speed: 0.05 # 低于该速度视为静止

# 踢球（左键，需把鞋拿在主手）
kick:
  range: 3.0 # 踢球判定距离（离球心）
  forward-power: 1.0 # 击球：水平初速
  forward-lift: 0.45 # 击球：垂直初速（普通踢球弧线，最高点约到玩家眼睛高度）
  vertical-power: 0.95 # 挑高靴：垂直初速（纯垂直击飞）
  kickoff-min-power: 0.6 # 开球力度 1 的水平初速
  kickoff-max-power: 2.2 # 力度映射上限（旧 8 档刻度的 8 档；现只发 1~4 档，数值与旧版一致）
  kickoff-lift-ratio: 0.45 # 开球垂直初速 = 水平初速 x 该比例（力度越大越高越远）
