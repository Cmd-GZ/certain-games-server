# ============================================================
# 记忆翻牌（MemoryFlip）配置文件
# 修改后在非对局状态执行 /memory reload，或重启服务器
# 注意：YAML 的冒号后面必须有空格，缩进必须用空格（不能用 Tab）
# ============================================================

# ---------- 人数 ----------
min-players: 2
# 最多玩家（同时也是 /memory build 默认生成的场地数）
max-players: 16

# ---------- 对局 ----------
# 一局时长（秒）
game-seconds: 20
# 开始前 title 倒计时（秒）
countdown-seconds: 3
# 一轮翻两张后，多久开始校对（tick，20 = 1 秒）
review-delay-ticks: 20

# ---------- 场地 ----------
# 每个玩家的竖直正方形翻牌墙：rows * cols 必须是偶数
board:
  rows: 4
  cols: 4
  # 相邻两块牌位之间的水平间距（格），建议 >= 5
  spacing: 6
  # 墙体 / 地台材质
  wall-material: SMOOTH_STONE
  floor-material: SMOOTH_STONE
  # 牌面物品池（每种物品会成对出现，数量必然为偶数）
  items:
  - DIAMOND
  - EMERALD
  - GOLD_INGOT
  - IRON_INGOT
  - APPLE
  - BREAD
  - COAL
  - REDSTONE
  - LAPIS_LAZULI
  - QUARTZ
  - SLIME_BALL
  - BLAZE_ROD
  - ENDER_PEARL
  - GHAST_TEAR
  - PRISMARINE_SHARD
  - AMETHYST_SHARD

# 等待点（/memory setlobby 写）
lobby: world_mini_game,-261.10,70.00,283.05

# 配置版本（迁移用，不要手改）
config-version: 1
countdown:
  enabled: true
  seconds: 3
  freeze: false
  title: '&e游戏即将开始：{time}'
  subtitle: '&7准备好'
