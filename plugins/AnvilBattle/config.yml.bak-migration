# ============================================================
# 铁砧掘战（AnvilBattle）配置文件
# 修改后在非对局状态执行 /anvil reload，或重启服务器
# 注意：YAML 的冒号后面必须有空格，缩进必须用空格（不能用 Tab）
# ============================================================

# ---------- 人数 ----------
# 最少开局人数（至少 2）
min-players: 2
# 最多人数
max-players: 12

# ---------- 对局 ----------
# 一局时长（秒）；时间到时仍存活的玩家共同获胜
game-seconds: 180

# ---------- 铁砧 ----------
anvil:
  # 每隔多少秒落一波铁砧
  interval-seconds: 1
  # 每波初始落几个铁砧
  amount: 35
  # 随时间增加每波数量：enabled=false 关闭；每 interval-seconds 秒多 amount-per-step 个，封顶 max-amount
  ramp:
    enabled: true
    interval-seconds: 10
    amount-per-step: 1
    max-amount: 40
  # 砸掉方块后继续往下钻多少秒再消失（0 = 砸完立刻消失）
  fall-after-break-seconds: 2
  # 在柱子最上方方块的头顶多少格生成
  spawn-height: 12
  # 落地时以落点为中心破坏周围 r 格（1 = 3×3）
  break-radius: 0
  # 从落点往下破坏几层（默认 2 = 落点那层 + 下面 2 层）
  break-depth: 0
  player-target:
    enabled: true
    base-chance: 0.15
    chance-step: 0.05
    max-chance: 0.5

# ---------- 场地 ----------
# 用指令设置，不要手写坐标；设置完成后 /anvil save
arena:
  # 场地范围两个对角（X/Y/Z 都取）
