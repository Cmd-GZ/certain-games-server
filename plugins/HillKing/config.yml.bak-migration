  - world_mini_game,624.75,53.00,303.46,0.0,0.0
  - world_mini_game,629.46,53.00,311.99,0.0,0.0
  - world_mini_game,627.24,53.00,309.29,0.0,0.0
  - world_mini_game,630.01,53.00,305.87,0.0,0.0
